<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <WebSceneNativeEngineMedia Condition="'$(WebSceneNativeEngineMedia)' == ''">false</WebSceneNativeEngineMedia>
    <WebSceneNativeEngineGraphics>false</WebSceneNativeEngineGraphics>
    <WebSceneNativeEngineGraphics Condition="'$(WebSceneGraphicsPackageProps)' != ''">true</WebSceneNativeEngineGraphics>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId Condition="'$(WebSceneNativeEngineRid)' != ''">WebScene.NativeEngine.Runtime.$(WebSceneNativeEngineRid)</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">WebScene.NativeEngine.Runtime.Template</PackageId>
    <WebSceneNativeEnginePlatformName>$(WebSceneNativeEngineRid)</WebSceneNativeEnginePlatformName>
    <WebSceneNativeEnginePlatformName Condition="'$(WebSceneNativeEngineRid)' == 'osx-arm64'">macOS on Apple silicon</WebSceneNativeEnginePlatformName>
    <WebSceneNativeEnginePlatformName Condition="'$(WebSceneNativeEngineRid)' == 'osx-x64'">macOS on Intel</WebSceneNativeEnginePlatformName>
    <WebSceneNativeEnginePlatformName Condition="'$(WebSceneNativeEngineRid)' == 'linux-x64'">Linux x64</WebSceneNativeEnginePlatformName>
    <WebSceneNativeEnginePlatformName Condition="'$(WebSceneNativeEngineRid)' == 'linux-arm64'">Linux ARM64</WebSceneNativeEnginePlatformName>
    <WebSceneNativeEnginePlatformName Condition="'$(WebSceneNativeEngineRid)' == 'win-x64'">Windows x64</WebSceneNativeEnginePlatformName>
    <Title>WebScene Native Engine Runtime for $(WebSceneNativeEnginePlatformName)</Title>
    <Description>Native WebScene V8, DOM, CSS, layout, Canvas, SVG, and immutable-scene runtime for $(WebSceneNativeEnginePlatformName) ($(WebSceneNativeEngineRid)), built to run trusted web-authored UI without a WebView or embedded browser.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/wieslawsoltes/WebScene</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>webscene;web-ui;dom;css;canvas;svg;v8;native;runtime;$(WebSceneNativeEngineRid)</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WebSceneNativeEngineAbiVersion>3</WebSceneNativeEngineAbiVersion>
    <WebSceneNativeEngineV8Revision>15.3.10</WebSceneNativeEngineV8Revision>
    <WebSceneNativeEngineV8PointerCompression Condition="'$(WebSceneNativeEngineV8PointerCompression)' == ''">false</WebSceneNativeEngineV8PointerCompression>
    <WebSceneNativeEngineV8SharedCage Condition="'$(WebSceneNativeEngineV8SharedCage)' == ''">false</WebSceneNativeEngineV8SharedCage>
    <WebSceneNativeEngineV8OptimizeForSizeDefault Condition="'$(WebSceneNativeEngineV8OptimizeForSizeDefault)' == ''">false</WebSceneNativeEngineV8OptimizeForSizeDefault>
    <WebSceneNativeEngineV8PartitionAlloc Condition="'$(WebSceneNativeEngineV8PartitionAlloc)' == ''">false</WebSceneNativeEngineV8PartitionAlloc>
    <WebSceneNativeEngineDenseLink Condition="'$(WebSceneNativeEngineDenseLink)' == ''">false</WebSceneNativeEngineDenseLink>
    <WebSceneNativeEngineThinLto Condition="'$(WebSceneNativeEngineThinLto)' == ''">false</WebSceneNativeEngineThinLto>
    <WebSceneNativeEngineCertificationTelemetry>false</WebSceneNativeEngineCertificationTelemetry>
    <WebSceneNativeEngineV8Inspector>true</WebSceneNativeEngineV8Inspector>
    <WebSceneNativeEngineHtmlParser Condition="'$(WebSceneNativeEngineHtmlParser)' == ''">html5ever</WebSceneNativeEngineHtmlParser>
    <WebSceneNativeEngineCssParser Condition="'$(WebSceneNativeEngineCssParser)' == ''">cssparser</WebSceneNativeEngineCssParser>
    <WebSceneNativeEngineSelectorParser Condition="'$(WebSceneNativeEngineSelectorParser)' == ''">servo</WebSceneNativeEngineSelectorParser>
    <WebSceneNativeEngineDomBindings Condition="'$(WebSceneNativeEngineDomBindings)' == ''">generated</WebSceneNativeEngineDomBindings>
    <WebSceneNativeEngineV8Snapshot Condition="'$(WebSceneNativeEngineV8Snapshot)' == ''">bootstrap</WebSceneNativeEngineV8Snapshot>
    <WebSceneNativeEngineConfiguration Condition="'$(WebSceneNativeEngineConfiguration)' == ''">Release</WebSceneNativeEngineConfiguration>
    <WebSceneNativeEngineBuilderIdentity Condition="'$(WebSceneNativeEngineBuilderIdentity)' == ''"></WebSceneNativeEngineBuilderIdentity>
    <WebSceneNativeEngineTargetTriple Condition="'$(WebSceneNativeEngineTargetTriple)' == ''"></WebSceneNativeEngineTargetTriple>
    <WebSceneNativeEngineGlibcBaseline Condition="'$(WebSceneNativeEngineGlibcBaseline)' == ''"></WebSceneNativeEngineGlibcBaseline>
    <WebSceneNativeEngineSupportedRids>osx-arm64;osx-x64;linux-arm64;linux-x64;win-arm64;win-x64</WebSceneNativeEngineSupportedRids>
    <WebSceneNativeEngineExpectedFileName Condition="$([System.String]::Copy('$(WebSceneNativeEngineRid)').StartsWith('osx-'))">libwebscene_native_engine.dylib</WebSceneNativeEngineExpectedFileName>
    <WebSceneNativeEngineExpectedFileName Condition="$([System.String]::Copy('$(WebSceneNativeEngineRid)').StartsWith('linux-'))">libwebscene_native_engine.so</WebSceneNativeEngineExpectedFileName>
    <WebSceneNativeEngineExpectedFileName Condition="$([System.String]::Copy('$(WebSceneNativeEngineRid)').StartsWith('win-'))">webscene_native_engine.dll</WebSceneNativeEngineExpectedFileName>
    <WebSceneNativeEngineExpectedIcuFileName>icudtl.dat</WebSceneNativeEngineExpectedIcuFileName>
    <WebSceneNativeEngineExpectedSnapshotFileName>webscene_bootstrap_snapshot.bin</WebSceneNativeEngineExpectedSnapshotFileName>
    <WebSceneNativeEngineExpectedSnapshotMetadataFileName>webscene_bootstrap_snapshot.meta</WebSceneNativeEngineExpectedSnapshotMetadataFileName>
    <WebSceneNativeEngineActualFileName Condition="'$(WebSceneNativeEnginePath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEnginePath)'))</WebSceneNativeEngineActualFileName>
    <WebSceneNativeEngineActualIcuFileName Condition="'$(WebSceneNativeEngineIcuDataPath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEngineIcuDataPath)'))</WebSceneNativeEngineActualIcuFileName>
    <WebSceneNativeEngineActualSnapshotFileName Condition="'$(WebSceneNativeEngineSnapshotPath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEngineSnapshotPath)'))</WebSceneNativeEngineActualSnapshotFileName>
    <WebSceneNativeEngineActualSnapshotMetadataFileName Condition="'$(WebSceneNativeEngineSnapshotMetadataPath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEngineSnapshotMetadataPath)'))</WebSceneNativeEngineActualSnapshotMetadataFileName>
    <WebSceneNativeEngineIsWindows>$([System.String]::Copy('$(WebSceneNativeEngineRid)').StartsWith('win-'))</WebSceneNativeEngineIsWindows>
    <WebSceneNativeEngineExpectedImportLibraryFileName>webscene_native_engine.lib</WebSceneNativeEngineExpectedImportLibraryFileName>
    <WebSceneNativeEngineExpectedCHeaderFileName>webscene_native_engine.h</WebSceneNativeEngineExpectedCHeaderFileName>
    <WebSceneNativeEngineActualImportLibraryFileName Condition="'$(WebSceneNativeEngineImportLibraryPath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEngineImportLibraryPath)'))</WebSceneNativeEngineActualImportLibraryFileName>
    <WebSceneNativeEngineActualCHeaderFileName Condition="'$(WebSceneNativeEngineCHeaderPath)' != ''">$([System.IO.Path]::GetFileName('$(WebSceneNativeEngineCHeaderPath)'))</WebSceneNativeEngineActualCHeaderFileName>
    <WebSceneNativePackageMetadataDir>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/native-package/</WebSceneNativePackageMetadataDir>
    <WebSceneNativeManifestPath>$(WebSceneNativePackageMetadataDir)webscene-native-runtime.json</WebSceneNativeManifestPath>
    <WebSceneNativePropsPath>$(WebSceneNativePackageMetadataDir)WebScene.NativeEngine.Runtime.props</WebSceneNativePropsPath>
    <WebSceneNativeWindowsCMakeMetadataPath>$(WebSceneNativePackageMetadataDir)WebSceneWindowsMetadata.cmake</WebSceneNativeWindowsCMakeMetadataPath>
    <WebSceneNativeV8LicensePackagePath>$(WebSceneNativePackageMetadataDir)V8-LICENSE.txt</WebSceneNativeV8LicensePackagePath>
    <WebSceneNativeIcuLicensePackagePath>$(WebSceneNativePackageMetadataDir)ICU-LICENSE.txt</WebSceneNativeIcuLicensePackagePath>
    <WebSceneNativeIXWebSocketLicensePackagePath>$(WebSceneNativePackageMetadataDir)IXWebSocket-LICENSE.txt</WebSceneNativeIXWebSocketLicensePackagePath>
    <WebSceneNativeMiniaudioLicensePackagePath>$(WebSceneNativePackageMetadataDir)Miniaudio-LICENSE.txt</WebSceneNativeMiniaudioLicensePackagePath>
    <WebSceneNativeMbedTlsLicensePackagePath>$(WebSceneNativePackageMetadataDir)MbedTLS-LICENSE.txt</WebSceneNativeMbedTlsLicensePackagePath>
    <WebSceneNativeHtmlParserNoticesPackagePath>$(WebSceneNativePackageMetadataDir)HTML-PARSER-THIRD-PARTY-NOTICES.md</WebSceneNativeHtmlParserNoticesPackagePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'">
    <_WebSceneWindowsCMakeMetadataLine Include="set(WebScene_PACKAGE_RID &quot;$(WebSceneNativeEngineRid)&quot;)" />
    <_WebSceneWindowsCMakeMetadataLine Include="set(WebScene_PACKAGE_ARCHITECTURE &quot;$(WebSceneNativeEngineArchitecture)&quot;)" />
    <_WebSceneWindowsCMakeMetadataLine Include="set(WebScene_PACKAGE_ABI_VERSION &quot;$(WebSceneNativeEngineAbiVersion)&quot;)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="WebScene.NativeEngine.Runtime.targets"
          Pack="true"
          PackagePath="buildTransitive\$(PackageId).targets" />
    <None Include="$(WebSceneNativeEnginePath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneNativeEngineRid)\native\$(WebSceneNativeEngineExpectedFileName)"
          Condition="'$(WebSceneNativeEnginePath)' != ''" />
    <None Include="$(WebSceneNativeEngineIcuDataPath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneNativeEngineRid)\native\$(WebSceneNativeEngineExpectedIcuFileName)"
          Condition="'$(WebSceneNativeEngineIcuDataPath)' != ''" />
    <None Include="$(WebSceneNativeEngineSnapshotPath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneNativeEngineRid)\native\$(WebSceneNativeEngineExpectedSnapshotFileName)"
          Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap'" />
    <None Include="$(WebSceneNativeEngineSnapshotMetadataPath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneNativeEngineRid)\native\$(WebSceneNativeEngineExpectedSnapshotMetadataFileName)"
          Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap'" />
    <None Include="$(WebSceneNativeV8LicensePackagePath)"
          Pack="true"
          PackagePath="licenses\V8-LICENSE.txt" />
    <None Include="$(WebSceneNativeIcuLicensePackagePath)"
          Pack="true"
          PackagePath="licenses\ICU-LICENSE.txt" />
    <None Include="$(WebSceneNativeIXWebSocketLicensePackagePath)"
          Pack="true"
          PackagePath="licenses\IXWebSocket-LICENSE.txt" />
    <None Include="$(WebSceneNativeMiniaudioLicensePackagePath)" Pack="true" Visible="false"
          PackagePath="licenses\Miniaudio-LICENSE.txt" Condition="'$(WebSceneNativeEngineMedia)' == 'true'" />
    <None Include="$(WebSceneNativeMbedTlsLicensePackagePath)"
          Pack="true"
          PackagePath="licenses\MbedTLS-LICENSE.txt"
          Condition="'$(WebSceneNativeEngineMbedTlsLicensePath)' != ''" />
    <None Include="$(WebSceneNativeHtmlParserNoticesPackagePath)"
          Pack="true"
          PackagePath="licenses\HTML-PARSER-THIRD-PARTY-NOTICES.md"
          Condition="'$(WebSceneNativeEngineHtmlParserNoticesPath)' != ''" />
    <None Include="$(WebSceneNativeManifestPath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneNativeEngineRid)\native\webscene-native-runtime.json" />
    <None Include="$(WebSceneNativePropsPath)"
          Pack="true"
          PackagePath="buildTransitive\$(PackageId).props" />
    <None Include="$(WebSceneNativeEngineImportLibraryPath)"
          Pack="true"
          PackagePath="build\native\lib\$(WebSceneNativeEngineExpectedImportLibraryFileName)"
          Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'" />
    <None Include="$(WebSceneNativeEngineCHeaderPath)"
          Pack="true"
          PackagePath="build\native\include\$(WebSceneNativeEngineExpectedCHeaderFileName)"
          Condition="Exists('$(WebSceneNativeEngineCHeaderPath)')" />
    <None Include="$(MSBuildProjectDirectory)/cmake/WebSceneConfig.cmake"
          Pack="true"
          PackagePath="build\native\lib\cmake\WebScene\WebSceneConfig.cmake"
          Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'" />
    <None Include="$(MSBuildProjectDirectory)/cmake/WebSceneWindowsConfig.cmake"
          Pack="true"
          PackagePath="build\native\lib\cmake\WebScene\WebSceneWindowsConfig.cmake"
          Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'" />
    <None Include="$(WebSceneNativeWindowsCMakeMetadataPath)"
          Pack="true"
          PackagePath="build\native\lib\cmake\WebScene\WebSceneWindowsMetadata.cmake"
          Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'" />
  </ItemGroup>

  <Import Project="$(WebSceneGraphicsPackageProps)" Condition="'$(WebSceneGraphicsPackageProps)' != ''" />

  <Target Name="ValidateWebSceneNativeEnginePackage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(WebSceneNativeEngineRid)' == '' or '$(WebSceneNativeEnginePath)' == '' or '$(WebSceneNativeEngineIcuDataPath)' == ''"
           Text="Packing the native WebScene runtime requires WebSceneNativeEngineRid, WebSceneNativeEnginePath, and WebSceneNativeEngineIcuDataPath." />
    <Error Condition="!$([System.String]::Copy(';$(WebSceneNativeEngineSupportedRids);').Contains(';$(WebSceneNativeEngineRid);'))"
           Text="Unsupported WebScene native engine RID '$(WebSceneNativeEngineRid)'. Supported RIDs: $(WebSceneNativeEngineSupportedRids)." />
    <Error Condition="!Exists('$(WebSceneNativeEnginePath)')"
           Text="The configured WebScene native engine does not exist: $(WebSceneNativeEnginePath)" />
    <Error Condition="!Exists('$(WebSceneNativeEngineIcuDataPath)')"
           Text="The configured V8 ICU data does not exist: $(WebSceneNativeEngineIcuDataPath)" />
    <Error Condition="'$(WebSceneNativeEngineMedia)' == 'true' and !Exists('$(WebSceneNativeEngineMiniaudioLicensePath)')"
           Text="Media-enabled runtime packaging requires the pinned Miniaudio license." />
    <Error Condition="!Exists('$(WebSceneNativeEngineV8LicensePath)') or !Exists('$(WebSceneNativeEngineIcuLicensePath)') or !Exists('$(WebSceneNativeEngineIXWebSocketLicensePath)')"
           Text="Packing the native WebScene runtime requires valid V8, ICU, and IXWebSocket license files." />
    <Error Condition="!Exists('$(WebSceneNativeEngineMbedTlsLicensePath)')"
           Text="Packing a native WebScene runtime requires a valid WebSceneNativeEngineMbedTlsLicensePath file." />
    <Error Condition="'$(WebSceneNativeEngineHtmlParserNoticesPath)' != '' and !Exists('$(WebSceneNativeEngineHtmlParserNoticesPath)')"
           Text="The configured HTML parser third-party notices file does not exist: $(WebSceneNativeEngineHtmlParserNoticesPath)" />
    <Error Condition="'$(WebSceneNativeEngineActualFileName)' != '$(WebSceneNativeEngineExpectedFileName)'"
           Text="Native engine file '$(WebSceneNativeEngineActualFileName)' does not match RID '$(WebSceneNativeEngineRid)'; expected '$(WebSceneNativeEngineExpectedFileName)'." />
    <Error Condition="'$(WebSceneNativeEngineActualIcuFileName)' != '$(WebSceneNativeEngineExpectedIcuFileName)'"
           Text="V8 ICU data file must be named '$(WebSceneNativeEngineExpectedIcuFileName)', not '$(WebSceneNativeEngineActualIcuFileName)'." />
    <Error Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap' and (!Exists('$(WebSceneNativeEngineSnapshotPath)') or !Exists('$(WebSceneNativeEngineSnapshotMetadataPath)'))"
           Text="Bootstrap snapshot packages require valid WebSceneNativeEngineSnapshotPath and WebSceneNativeEngineSnapshotMetadataPath files." />
    <Error Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap' and '$(WebSceneNativeEngineActualSnapshotFileName)' != '$(WebSceneNativeEngineExpectedSnapshotFileName)'"
           Text="V8 snapshot file must be named '$(WebSceneNativeEngineExpectedSnapshotFileName)', not '$(WebSceneNativeEngineActualSnapshotFileName)'." />
    <Error Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap' and '$(WebSceneNativeEngineActualSnapshotMetadataFileName)' != '$(WebSceneNativeEngineExpectedSnapshotMetadataFileName)'"
           Text="V8 snapshot metadata file must be named '$(WebSceneNativeEngineExpectedSnapshotMetadataFileName)', not '$(WebSceneNativeEngineActualSnapshotMetadataFileName)'." />
    <Error Condition="'$(WebSceneNativeEngineV8PointerCompression)' != 'true' and '$(WebSceneNativeEngineV8PointerCompression)' != 'false'"
           Text="WebSceneNativeEngineV8PointerCompression must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineV8SharedCage)' != 'true' and '$(WebSceneNativeEngineV8SharedCage)' != 'false'"
           Text="WebSceneNativeEngineV8SharedCage must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineV8OptimizeForSizeDefault)' != 'true' and '$(WebSceneNativeEngineV8OptimizeForSizeDefault)' != 'false'"
           Text="WebSceneNativeEngineV8OptimizeForSizeDefault must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineV8PartitionAlloc)' != 'true' and '$(WebSceneNativeEngineV8PartitionAlloc)' != 'false'"
           Text="WebSceneNativeEngineV8PartitionAlloc must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineDenseLink)' != 'true' and '$(WebSceneNativeEngineDenseLink)' != 'false'"
           Text="WebSceneNativeEngineDenseLink must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineThinLto)' != 'true' and '$(WebSceneNativeEngineThinLto)' != 'false'"
           Text="WebSceneNativeEngineThinLto must be the JSON boolean true or false." />
    <Error Condition="'$(WebSceneNativeEngineCertificationTelemetry)' != 'false'"
           Text="Native runtime packages must compile certification telemetry out." />
    <Error Condition="'$(WebSceneNativeEngineV8Inspector)' != 'true'"
           Text="Published native runtime packages must include V8 Inspector support." />
    <Error Condition="'$(WebSceneNativeEngineHtmlParser)' != 'legacy' and '$(WebSceneNativeEngineHtmlParser)' != 'html5ever'"
           Text="WebSceneNativeEngineHtmlParser must be legacy or html5ever." />
    <Error Condition="'$(WebSceneNativeEngineCssParser)' != 'legacy' and '$(WebSceneNativeEngineCssParser)' != 'cssparser'"
           Text="WebSceneNativeEngineCssParser must be legacy or cssparser." />
    <Error Condition="'$(WebSceneNativeEngineSelectorParser)' != 'legacy' and '$(WebSceneNativeEngineSelectorParser)' != 'servo'"
           Text="WebSceneNativeEngineSelectorParser must be legacy or servo." />
    <Error Condition="'$(WebSceneNativeEngineDomBindings)' != 'legacy' and '$(WebSceneNativeEngineDomBindings)' != 'generated'"
           Text="WebSceneNativeEngineDomBindings must be legacy or generated." />
    <Error Condition="'$(WebSceneNativeEngineV8Snapshot)' != 'none' and '$(WebSceneNativeEngineV8Snapshot)' != 'bootstrap'"
           Text="WebSceneNativeEngineV8Snapshot must be none or bootstrap." />
    <Error Condition="'$(WebSceneNativeEngineConfiguration)' != 'Release' and '$(WebSceneNativeEngineConfiguration)' != 'RelWithDebInfo'"
           Text="WebSceneNativeEngineConfiguration must be Release or RelWithDebInfo." />
    <Error Condition="('$(WebSceneNativeEngineCssParser)' == 'cssparser' or '$(WebSceneNativeEngineSelectorParser)' == 'servo') and '$(WebSceneNativeEngineHtmlParser)' != 'html5ever'"
           Text="The Servo CSS components require the shared html5ever Rust standards library." />
    <Error Condition="'$(WebSceneNativeEngineHtmlParser)' == 'html5ever' and '$(WebSceneNativeEngineHtmlParserNoticesPath)' == ''"
           Text="html5ever runtime packages require WebSceneNativeEngineHtmlParserNoticesPath." />
    <Error Condition="'$(WebSceneNativeEngineV8SharedCage)' == 'true' and '$(WebSceneNativeEngineV8PointerCompression)' != 'true'"
           Text="A shared V8 compression cage requires pointer compression." />
    <Error Condition="'$(WebSceneNativeEngineIsWindows)' == 'true' and ('$(WebSceneNativeEngineArchitecture)' != 'x64' and '$(WebSceneNativeEngineArchitecture)' != 'arm64')"
           Text="Windows C/C++ packaging requires WebSceneNativeEngineArchitecture=x64 or arm64." />
    <Error Condition="'$(WebSceneNativeEngineRid)' == 'win-x64' and '$(WebSceneNativeEngineArchitecture)' != 'x64'"
           Text="RID win-x64 requires C/C++ package architecture x64." />
    <Error Condition="'$(WebSceneNativeEngineRid)' == 'win-arm64' and '$(WebSceneNativeEngineArchitecture)' != 'arm64'"
           Text="RID win-arm64 requires C/C++ package architecture arm64." />
    <Error Condition="'$(WebSceneNativeEngineIsWindows)' == 'true' and !Exists('$(WebSceneNativeEngineImportLibraryPath)')"
           Text="Windows C/C++ packaging requires the native engine import library: $(WebSceneNativeEngineImportLibraryPath)" />
    <Error Condition="'$(WebSceneNativeEngineIsWindows)' == 'true' and '$(WebSceneNativeEngineActualImportLibraryFileName)' != '$(WebSceneNativeEngineExpectedImportLibraryFileName)'"
           Text="The Windows native engine import library must be named $(WebSceneNativeEngineExpectedImportLibraryFileName)." />
    <Error Condition="!Exists('$(WebSceneNativeEngineCHeaderPath)')"
           Text="Native runtime packaging requires the public C header: $(WebSceneNativeEngineCHeaderPath)" />
    <Error Condition="'$(WebSceneNativeEngineActualCHeaderFileName)' != '$(WebSceneNativeEngineExpectedCHeaderFileName)'"
           Text="The native engine C header must be named $(WebSceneNativeEngineExpectedCHeaderFileName)." />
    <Error Condition="'$(WebSceneNativeEngineIsWindows)' == 'true' and !Exists('$(MSBuildProjectDirectory)/cmake/WebSceneConfig.cmake')"
           Text="Windows C/C++ packaging requires cmake/WebSceneConfig.cmake." />
    <Error Condition="'$(WebSceneNativeEngineIsWindows)' == 'true' and !Exists('$(MSBuildProjectDirectory)/cmake/WebSceneWindowsConfig.cmake')"
           Text="Windows C/C++ packaging requires cmake/WebSceneWindowsConfig.cmake." />
  </Target>

  <Target Name="PrepareWebSceneNativeEnginePackage"
          BeforeTargets="GenerateNuspec"
          DependsOnTargets="ValidateWebSceneNativeEnginePackage">
    <MakeDir Directories="$(WebSceneNativePackageMetadataDir)" />
    <Copy SourceFiles="$(WebSceneNativeEngineMiniaudioLicensePath)" DestinationFiles="$(WebSceneNativeMiniaudioLicensePackagePath)"
          Condition="'$(WebSceneNativeEngineMedia)' == 'true'" />
    <Copy SourceFiles="$(WebSceneNativeEngineV8LicensePath)"
          DestinationFiles="$(WebSceneNativeV8LicensePackagePath)" />
    <Copy SourceFiles="$(WebSceneNativeEngineIcuLicensePath)"
          DestinationFiles="$(WebSceneNativeIcuLicensePackagePath)" />
    <Copy SourceFiles="$(WebSceneNativeEngineIXWebSocketLicensePath)"
          DestinationFiles="$(WebSceneNativeIXWebSocketLicensePackagePath)" />
    <Copy SourceFiles="$(WebSceneNativeEngineMbedTlsLicensePath)"
          DestinationFiles="$(WebSceneNativeMbedTlsLicensePackagePath)"
          Condition="'$(WebSceneNativeEngineMbedTlsLicensePath)' != ''" />
    <Copy SourceFiles="$(WebSceneNativeEngineHtmlParserNoticesPath)"
          DestinationFiles="$(WebSceneNativeHtmlParserNoticesPackagePath)"
          Condition="'$(WebSceneNativeEngineHtmlParserNoticesPath)' != ''" />
    <GetFileHash Files="$(WebSceneNativeEnginePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineHash" />
    </GetFileHash>
    <GetFileHash Files="$(WebSceneNativeEngineIcuDataPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineIcuHash" />
    </GetFileHash>
    <GetFileHash Files="$(WebSceneNativeEngineSnapshotPath)" Algorithm="SHA256"
                 Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap'">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineSnapshotHash" />
    </GetFileHash>
    <GetFileHash Files="$(WebSceneNativeEngineSnapshotMetadataPath)" Algorithm="SHA256"
                 Condition="'$(WebSceneNativeEngineV8Snapshot)' == 'bootstrap'">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineSnapshotMetadataHash" />
    </GetFileHash>
    <GetFileHash Files="$(WebSceneNativeEngineImportLibraryPath)" Algorithm="SHA256"
                 Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineImportLibraryHash" />
    </GetFileHash>
    <GetFileHash Files="$(WebSceneNativeEngineCHeaderPath)" Algorithm="SHA256"
                 Condition="Exists('$(WebSceneNativeEngineCHeaderPath)')">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeEngineCHeaderHash" />
    </GetFileHash>
    <PropertyGroup>
      <WebSceneNativeEngineHash>@(_WebSceneNativeEngineHash->'%(FileHash)')</WebSceneNativeEngineHash>
      <WebSceneNativeEngineIcuHash>@(_WebSceneNativeEngineIcuHash->'%(FileHash)')</WebSceneNativeEngineIcuHash>
      <WebSceneNativeEngineSnapshotHash>@(_WebSceneNativeEngineSnapshotHash->'%(FileHash)')</WebSceneNativeEngineSnapshotHash>
      <WebSceneNativeEngineSnapshotMetadataHash>@(_WebSceneNativeEngineSnapshotMetadataHash->'%(FileHash)')</WebSceneNativeEngineSnapshotMetadataHash>
      <WebSceneNativeEngineImportLibraryHash>@(_WebSceneNativeEngineImportLibraryHash->'%(FileHash)')</WebSceneNativeEngineImportLibraryHash>
      <WebSceneNativeEngineCHeaderHash>@(_WebSceneNativeEngineCHeaderHash->'%(FileHash)')</WebSceneNativeEngineCHeaderHash>
      <WebSceneNativeEngineHeaderManifestFragment>,&quot;cHeaderFileName&quot;:&quot;$(WebSceneNativeEngineExpectedCHeaderFileName)&quot;,&quot;cHeaderSha256&quot;:&quot;$(WebSceneNativeEngineCHeaderHash)&quot;</WebSceneNativeEngineHeaderManifestFragment>
      <WebSceneNativeEngineCppManifestFragment Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'">,&quot;architecture&quot;:&quot;$(WebSceneNativeEngineArchitecture)&quot;,&quot;importLibraryFileName&quot;:&quot;$(WebSceneNativeEngineExpectedImportLibraryFileName)&quot;,&quot;importLibrarySha256&quot;:&quot;$(WebSceneNativeEngineImportLibraryHash)&quot;</WebSceneNativeEngineCppManifestFragment>
    </PropertyGroup>
    <WriteLinesToFile File="$(WebSceneNativeManifestPath)"
                      Lines="{&quot;schemaVersion&quot;:2,&quot;packageVersion&quot;:&quot;$(PackageVersion)&quot;,&quot;runtimeIdentifier&quot;:&quot;$(WebSceneNativeEngineRid)&quot;$(WebSceneNativeEngineHeaderManifestFragment)$(WebSceneNativeEngineCppManifestFragment),&quot;fileName&quot;:&quot;$(WebSceneNativeEngineExpectedFileName)&quot;,&quot;sha256&quot;:&quot;$(WebSceneNativeEngineHash)&quot;,&quot;icuFileName&quot;:&quot;$(WebSceneNativeEngineExpectedIcuFileName)&quot;,&quot;icuSha256&quot;:&quot;$(WebSceneNativeEngineIcuHash)&quot;,&quot;snapshotFileName&quot;:&quot;$(WebSceneNativeEngineExpectedSnapshotFileName)&quot;,&quot;snapshotSha256&quot;:&quot;$(WebSceneNativeEngineSnapshotHash)&quot;,&quot;snapshotMetadataFileName&quot;:&quot;$(WebSceneNativeEngineExpectedSnapshotMetadataFileName)&quot;,&quot;snapshotMetadataSha256&quot;:&quot;$(WebSceneNativeEngineSnapshotMetadataHash)&quot;,&quot;abiVersion&quot;:$(WebSceneNativeEngineAbiVersion),&quot;v8Revision&quot;:&quot;$(WebSceneNativeEngineV8Revision)&quot;,&quot;htmlParser&quot;:&quot;$(WebSceneNativeEngineHtmlParser)&quot;,&quot;cssParser&quot;:&quot;$(WebSceneNativeEngineCssParser)&quot;,&quot;selectorParser&quot;:&quot;$(WebSceneNativeEngineSelectorParser)&quot;,&quot;domBindings&quot;:&quot;$(WebSceneNativeEngineDomBindings)&quot;,&quot;v8Snapshot&quot;:&quot;$(WebSceneNativeEngineV8Snapshot)&quot;,&quot;v8PointerCompression&quot;:$(WebSceneNativeEngineV8PointerCompression),&quot;v8SharedCage&quot;:$(WebSceneNativeEngineV8SharedCage),&quot;v8OptimizeForSizeDefault&quot;:$(WebSceneNativeEngineV8OptimizeForSizeDefault),&quot;v8PartitionAlloc&quot;:$(WebSceneNativeEngineV8PartitionAlloc),&quot;v8Inspector&quot;:$(WebSceneNativeEngineV8Inspector),&quot;denseLink&quot;:$(WebSceneNativeEngineDenseLink),&quot;thinLto&quot;:$(WebSceneNativeEngineThinLto),&quot;certificationTelemetry&quot;:$(WebSceneNativeEngineCertificationTelemetry),&quot;configuration&quot;:&quot;$(WebSceneNativeEngineConfiguration)&quot;,&quot;builderIdentity&quot;:&quot;$(WebSceneNativeEngineBuilderIdentity)&quot;,&quot;targetTriple&quot;:&quot;$(WebSceneNativeEngineTargetTriple)&quot;,&quot;glibcBaseline&quot;:&quot;$(WebSceneNativeEngineGlibcBaseline)&quot;}"
                      Overwrite="true" />
    <WriteLinesToFile File="$(WebSceneNativeWindowsCMakeMetadataPath)"
                      Lines="@(_WebSceneWindowsCMakeMetadataLine)"
                      Overwrite="true"
                      Condition="'$(WebSceneNativeEngineIsWindows)' == 'true'" />
    <WriteLinesToFile File="$(WebSceneNativePropsPath)"
